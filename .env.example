# Copy this file to .env and change the values.

# Password for the staff page at /#/admin (REQUIRED in production)
ADMIN_PASSWORD=change-me-to-something-long

# Random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port for the server (default 3001)
PORT=3001

# Where the SQLite database file lives (default ./data/coffee.db)
# DATABASE_PATH=./data/coffee.db

# Set to true only if you run behind a reverse proxy (Nginx, Render, Railway, etc.)
# TRUST_PROXY=true
